# UXFlow environment template. Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored; never commit real keys. See SECURITY.md.
#
# UXFlow routes all LLM calls through a LiteLLM proxy (one base URL, one key,
# many models). Stand up LiteLLM separately — see https://docs.litellm.ai/.
# The proxy must expose the models named below on your provider.

# ─── Required ────────────────────────────────────────────────────────────
# LiteLLM proxy base URL (OpenAI-compatible /v1 endpoint).
LITELLM_BASE="http://localhost:4000/v1"
# LiteLLM proxy API key.
LITELLM_KEY=""

# ─── Optional: model selection (defaults shown) ──────────────────────────
# Model that compiles ProblemSpec in module0 (high-leverage, low-volume).
# Default: gpt-5.5. Must follow strict JSON output.
UXFLOW_COMPILE_MODEL=gpt-5.5
# Model that judges trajectory slices in module1 (highest-volume LLM call).
UXFLOW_JUDGE_MODEL=gpt-4o-mini
# Legacy alias, honoured as a fallback for the JUDGE slot only (never compile,
# which needs the strict-JSON model above). Prefer UXFLOW_JUDGE_MODEL.
MODULE0_TEST_MODEL=gpt-4o-mini

# ─── Optional: runtime paths & tuning ────────────────────────────────────
# SQLite DB for module0.5 label self-evolution. Default: XDG data dir
# (~/.local/share/uxflow/uxflow.db). Override or use `uxflow-evolve --db`.
# UXFLOW_DB=
# Question-level dedup threshold for the Inspector search path. Default 0.90.
UXFLOW_QUESTION_DEDUP_THRESHOLD=0.90

# ─── Embedding backend ───────────────────────────────────────────────────
# fake (default, zero ML deps) | local (Qwen3-Embedding-0.6B, needs the
# local-embed extra, 1024-dim) | api (any OpenAI-compatible endpoint, 3072-dim
# default)
# 'fake' produces deterministic but semantically MEANINGLESS vectors — fine for
# smoke-testing that the pipeline runs, not for real curation.
# Note: vectors persisted in UXFLOW_DB are backend-specific. If you switch
# backends, point UXFLOW_DB at a fresh database. This matters even more
# between local and api: 1024-dim vs 3072-dim vectors are different shapes
# and semantically unrelated, not just differently-scaled.
UXFLOW_EMBED_BACKEND=fake

# api backend only (UXFLOW_EMBED_BACKEND=api). Credentials are resolved in
# this order: LITELLM_KEY / LITELLM_BASE (the pair already configured above)
# first, falling back to OPENAI_API_KEY / UXFLOW_EMBED_API_BASE. Because
# LITELLM_KEY/LITELLM_BASE are already set above, switching to api needs NO
# new entries — the two lines below are only for a separate, non-LiteLLM
# embedding endpoint.
# UXFLOW_EMBED_API_MODEL=text-embedding-3-large
# UXFLOW_EMBED_API_DIM=3072
# OPENAI_API_KEY=
# UXFLOW_EMBED_API_BASE=https://api.openai.com/v1

# Restricted-network tuning for the api backend (defaults shown; uncomment to
# override).
# UXFLOW_EMBED_BATCH=32
# UXFLOW_EMBED_TIMEOUT=25
# UXFLOW_EMBED_MAX_TRIES=5
#
# Response size is deterministic: base64-encoded float32 at 3072 dims is
# exactly 16,384 bytes/vector, so response size scales with batch size as:
#   batch 16  -> 0.26 MB
#   batch 32  -> 0.51 MB   (default)
#   batch 64  -> 1.03 MB
#   batch 128 -> 2.06 MB
# The target deployment's gateway caps responses near 1 MB, so batch 64
# already exceeds it — that's why 32 is the default. Pick a batch size
# against your own gateway's limit using the table above.

# ─── LLM backend ─────────────────────────────────────────────────────────
# real (default) | fake
# 'real' routes through the LiteLLM proxy above and FAILS LOUDLY if
# LITELLM_BASE/LITELLM_KEY are missing — it never silently degrades.
# 'fake' replays fixed scripted responses so a fresh clone can run the whole
# pipeline with no proxy at all. Those results are NOT model output: they only
# prove the pipeline wires together. Every run announces which backend is live.
UXFLOW_LLM_BACKEND=real

# Only once the Qwen model is already cached locally: skip HuggingFace's network
# revision check (a flaky network returns RST and breaks it). Leave these
# COMMENTED OUT on first run, or the initial model download is blocked.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# ─── Test flag (leave unset for normal runs) ──────────────────────────────
# Set to 1 to enable module0 integration tests against a live LiteLLM proxy.
# MODULE0_INTEGRATION=1
