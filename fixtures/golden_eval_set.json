{
  "version": "1.0",
  "description": "Golden eval set for Module 0 prompt optimization. Expected labels are the standard answer for accuracy/drift metrics.",
  "matching_semantics": {
    "target_capability": "set-overlap: expected labels must all appear in output (subset match); __NEW__ means any taxonomy_extension label is acceptable",
    "route": "exact match",
    "drop_reason": "exact match, only checked when route==drop",
    "sub_problem_count": "expected number of sub-problems after decomposition (pass + drop combined)"
  },
  "cases": [
    {
      "id": "e01",
      "raw_input": "用户提供了三个文件，模型在处理过程中把文件内容搞混了",
      "expected": [
        {"target_capability": ["file_localization_and_edit"], "route": "pass"}
      ]
    },
    {
      "id": "e02",
      "raw_input": "python代码写入时有语法错误，且缩进出现问题",
      "expected": [
        {"target_capability": ["valid_syntax_in_toolcall"], "route": "pass"},
        {"target_capability": ["correct_indentation"], "route": "pass"}
      ]
    },
    {
      "id": "e03",
      "raw_input": "agent工具解析有问题,tool_call的标签出现在thinking里面",
      "expected": [
        {"target_capability": ["wellformed_tool_call"], "route": "pass"}
      ]
    },
    {
      "id": "e04",
      "raw_input": "python实现五子棋，玩家胜利后无胜利提示，用户提醒后仍然没有实现",
      "expected": [
        {"target_capability": ["requirement_completeness"], "route": "pass"}
      ]
    },
    {
      "id": "e05",
      "raw_input": "用户提示使用python虚拟环境，但模型仍然未使用直接执行",
      "expected": [
        {"target_capability": ["__NEW__"], "route": "pass"}
      ]
    },
    {
      "id": "e06",
      "raw_input": "复杂问题理解不全面就开始实现，导致实现逻辑出错",
      "expected": [
        {"target_capability": ["requirement_analysis_before_coding"], "route": "pass"}
      ]
    },
    {
      "id": "e07",
      "raw_input": "bash command中python代码闭合有问题",
      "expected": [
        {"target_capability": ["correct_shell_embedding"], "route": "pass"}
      ]
    },
    {
      "id": "e08",
      "raw_input": "修复bug前没有先复现问题就开始改代码",
      "expected": [
        {"target_capability": ["reproduce_before_fix"], "route": "pass"}
      ]
    },
    {
      "id": "e09",
      "raw_input": "相同的错误处理方式重复尝试了五六次，没有切换策略",
      "expected": [
        {"target_capability": ["avoid_redundant_repetition"], "route": "pass"}
      ]
    },
    {
      "id": "e10",
      "raw_input": "实现完功能后没有验证，直接交给用户，结果还是有bug",
      "expected": [
        {"target_capability": ["self_verification"], "route": "pass"}
      ]
    },
    {
      "id": "e11",
      "raw_input": "用户指出代码有bug后，模型说修复了但实际运行还是有同样的错误",
      "expected": [
        {"target_capability": ["effective_error_fix"], "route": "pass"}
      ]
    },
    {
      "id": "e12",
      "raw_input": "编辑文件时找错了位置，改了别的函数",
      "expected": [
        {"target_capability": ["file_localization_and_edit"], "route": "pass"}
      ]
    },
    {
      "id": "e13",
      "raw_input": "输出的UI样式不好看",
      "expected": [
        {"route": "drop", "drop_reason": "not_applicable"}
      ]
    },
    {
      "id": "e14",
      "raw_input": "回答速度太慢",
      "expected": [
        {"route": "drop", "drop_reason": "not_applicable"}
      ]
    },
    {
      "id": "e15",
      "raw_input": "代码有问题",
      "expected": [
        {"route": "drop", "drop_reason": "ambiguous"}
      ]
    },
    {
      "id": "e16",
      "raw_input": "整体感觉不太行，有很多小问题",
      "expected": [
        {"route": "drop", "drop_reason": "ambiguous"}
      ]
    },
    {
      "id": "e17",
      "raw_input": "编辑文件出错了，工具调用也有问题，而且没有分析需求",
      "expected": [
        {"target_capability": ["file_localization_and_edit"], "route": "pass"},
        {"target_capability": ["wellformed_tool_call"], "route": "pass"},
        {"target_capability": ["requirement_analysis_before_coding"], "route": "pass"}
      ]
    },
    {
      "id": "e18",
      "raw_input": "生成的代码语法没错但逻辑完全不对",
      "expected": [
        {"route": "drop", "drop_reason": "label_diverged"}
      ]
    },
    {
      "id": "e19",
      "raw_input": "模型一直在循环尝试同一种方法，最后超时了",
      "expected": [
        {"target_capability": ["avoid_redundant_repetition"], "route": "pass"}
      ]
    },
    {
      "id": "e20",
      "raw_input": "有时候行有时候不行",
      "expected": [
        {"route": "drop", "drop_reason": "ambiguous"}
      ]
    }
  ]
}
